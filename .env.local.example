# Copy this file to .env.local (git-ignored) and fill it in. start-service.sh reads it.
#   cp .env.local.example .env.local && chmod 600 .env.local
# Never commit real values, and never paste passwords or tokens into chat or tickets.

# --- How the admin hears about a new booking request: email (default) or whatsapp ---
# NOTIFY_CHANNEL=email

# --- Email alerts to the admin (leave EMAIL_ENABLED=false for test mode: the email is only written to the log) ---
EMAIL_ENABLED=false
# Gmail: smtp.gmail.com and port 587. Other providers give you their own SMTP host and port.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
# The account that sends the alerts. For Gmail this is the full address.
EMAIL_USERNAME=
# For Gmail this must be an "app password" (needs 2-Step Verification), not the normal password
EMAIL_PASSWORD=
# Optional: the From address when it differs from EMAIL_USERNAME (not possible with Gmail)
# EMAIL_FROM=
# Where the alerts go: one address, or several separated by commas
EMAIL_ADMIN_TO=

# --- WhatsApp alerts to the admin (only used when NOTIFY_CHANNEL=whatsapp; WHATSAPP_ENABLED=false is test mode) ---
WHATSAPP_ENABLED=false
# Permanent access token of a "system user" (the temporary token in Meta's API Setup page expires)
WHATSAPP_TOKEN=
# The "Phone number ID" shown on Meta's API Setup page (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# The Graph API version shown in Meta's console, for example v22.0 (use the one Meta shows you)
WHATSAPP_API_VERSION=
# The admin's WhatsApp number: digits only, with country code, no + and no spaces. Example: 94771234567
WHATSAPP_ADMIN_TO=
# Must match the approved template exactly
WHATSAPP_TEMPLATE_NAME=new_booking_details
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Optional ---
# GOOGLE_CLIENT_ID=
# BACKEND_PORT=8081
